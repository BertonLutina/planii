{
  "expo": {
    "name": "Planii",
    "slug": "planii",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "planii",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6d5cff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.planii.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Planii convertit votre voix en texte pour remplir vos champs à la dictée.",
        "NSMicrophoneUsageDescription": "Planii utilise le micro pour dicter vos tâches et vos messages.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.planii.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#6d5cff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Planii utilise vos photos pour votre avatar et les images de projet."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Planii utilise le micro pour dicter vos tâches et vos messages.",
          "speechRecognitionPermission": "Planii convertit votre voix en texte pour remplir vos champs à la dictée.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.planii.app/api",
      "router": {},
      "eas": {
        "projectId": "984e1cb0-9b27-4ae5-a014-dea6e121ca26"
      }
    },
    "owner": "creaafde"
  }
}
