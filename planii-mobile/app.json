{
  "expo": {
    "name": "Planii",
    "slug": "planii",
    "version": "1.11.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "planii",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/984e1cb0-9b27-4ae5-a014-dea6e121ca26"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.planii.mobile",
      "associatedDomains": [
        "applinks:planii.app",
        "applinks:www.planii.app"
      ],
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Planii convertit votre voix en texte pour remplir vos champs à la dictée.",
        "NSMicrophoneUsageDescription": "Planii utilise le micro pour dicter et pour la visioconférence.",
        "NSCameraUsageDescription": "Planii utilise la caméra pour la visioconférence du projet.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.planii.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#6d5cff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "planii.app",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "www.planii.app",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "planii.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.planii.app",
              "pathPrefix": "/invite"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Planii utilise Face ID pour vérifier que c’est bien toi à l’ouverture de l’app. Face ID ne remplace pas ton mot de passe."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Planii utilise vos photos pour votre avatar et les images de projet."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Planii utilise le micro pour dicter et pour la visioconférence.",
          "speechRecognitionPermission": "Planii convertit votre voix en texte pour remplir vos champs à la dictée.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6d5cff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-web-browser",
      "expo-status-bar",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Planii utilise la caméra pour la visioconférence du projet.",
          "microphonePermission": "Planii utilise le micro pour dicter et pour la visioconférence."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.planii.app/api",
      "router": {},
      "eas": {
        "projectId": "984e1cb0-9b27-4ae5-a014-dea6e121ca26"
      }
    },
    "owner": "creaafde"
  }
}
