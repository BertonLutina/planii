# Copiez ce fichier en « .env » et adaptez les valeurs.

# Port d'écoute du backend
PORT=4000

# Connexion à votre PostgreSQL (Hostinger). Format :
#   postgres://UTILISATEUR:MOTDEPASSE@HOTE:5432/NOM_BASE
# Exemple local sur le VPS : postgres://planii:motdepasse@localhost:5432/planii
DATABASE_URL=postgres://planii:motdepasse@localhost:5432/planii

# Mettre à "true" si votre PostgreSQL exige une connexion SSL (souvent le cas
# pour une base managée/distante ; inutile si Postgres tourne sur le même VPS).
PGSSL=false

# Secret pour signer les jetons de connexion (JWT).
# Générez une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacez-par-une-valeur-aleatoire-longue

# Environnement : development | test | production
NODE_ENV=production

# Origines CORS autorisées (séparées par des virgules, ou * pour tout)
CORS_ORIGINS=https://planii.app,https://www.planii.app,http://localhost:5173

# URL publique de l'application front (utilisée dans les liens d'invitation).
APP_URL=https://planii.app

# Durée de validité des liens d'invitation (en jours)
INVITE_DAYS=14

# OAuth (optionnel — laissez vide pour désactiver le bouton)
# Callback : https://api.planii.app/api/auth/{provider}/callback
# (dev : http://localhost:4000/api/auth/{provider}/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Optionnel : base publique de l'API pour les callbacks OAuth
# OAUTH_CALLBACK_BASE=https://api.planii.app
# SESSION_SECRET= # défaut = JWT_SECRET
